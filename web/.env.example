# web/.env.example — copy to web/.env.local (gitignored) for local dev, and
# set the same names in Vercel > Project > Settings > Environment Variables.
# NEVER commit real values. Everything below is read at request time, so
# `next build` works with none of it set.

# --- Supabase (dashboard) --------------------------------------------------
# Browser-safe. Settings > Data API (URL) and API Keys (publishable / anon).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (eBay API routes only; SERVER-ONLY) ---------------------------
# Service-role key: bypasses RLS. Used only by /api/ebay/* through
# lib/supabase/admin.ts (import "server-only"). No NEXT_PUBLIC_ prefix, so it
# can never be inlined into a browser bundle. Never use it from a page.
SUPABASE_SERVICE_ROLE_KEY=
# UUID of the owner account (Auth > Users). The sync and CDP import scope
# card/ledger reads to it. Optional if Auth has exactly one user.
OWNER_USER_ID=

# --- eBay keyset (developer.ebay.com > Application Keys) --------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=
# RuName (eBay Redirect URL name) — NOT a URL. User Tokens > "Get a Token from
# eBay via Your Application" > your RuName. Sent as redirect_uri.
EBAY_RUNAME=
# production (default) | sandbox
EBAY_ENV=production
# default EBAY_US
EBAY_MARKETPLACE_ID=EBAY_US
# 1 = also request commerce.catalog.readonly + buy.marketplace.insights on
# user consent. Leave unset unless your keyset has them (else consent fails).
EBAY_EXTRA_SCOPES=

# --- Listing defaults (or POST /api/ebay/policies, or per-request override) -
# Fulfillment = shipping policy. Create a NEW one in Seller Hub for these
# cards first; it is never auto-selected, and real imports refuse without it.
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=

# --- Marketplace Account Deletion (required for a production keyset) -------
# 32-80 chars, A-Z a-z 0-9 _ - ; must match what you enter in the portal.
EBAY_VERIFICATION_TOKEN=
# Exactly the URL registered in the portal.
EBAY_ACCOUNT_DELETION_ENDPOINT=https://jho-collects.vercel.app/api/ebay/account-deletion

# --- Machine auth ------------------------------------------------------------
# x-api-key for every /api/ebay/* endpoint Yoshi calls. Long and random:
#   openssl rand -hex 32
SHOTIME_API_KEY=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Long and random.
CRON_SECRET=

# Optional. Not read by the code today: eBay stores the callback URL against
# the RuName, so nothing needs to build it. Kept for reference.
NEXT_PUBLIC_APP_URL=https://jho-collects.vercel.app
