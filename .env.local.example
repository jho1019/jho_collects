# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# All values come from the Supabase dashboard (see docs/PHASES.md, Phase 0).

# Project URL — Settings > Data API (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=

# Browser-safe key. RLS enforced. Settings > API Keys:
#   new dashboard -> "Publishable key" (sb_publishable_...)
#   legacy tab    -> "anon" / "public"
SUPABASE_ANON_KEY=

# Privileged key. Bypasses RLS. Server / CLI only -- NEVER in the browser.
# Settings > API Keys:
#   new dashboard -> "Secret key" (sb_secret_...)
#   legacy tab    -> "service_role"
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string — Connect button (top bar) > "Direct
# Connection string" tab > Session pooler. Used by scripts/check_connection.py
# and the Phase 5 backup cron. Replace [YOUR-PASSWORD] with the database
# password (Settings > Database), percent-encoding any @ : / ? # [ ] % in it.
# postgresql://postgres.<ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# UUID of the single owner account created via Supabase Auth.
# Auth > Users > (your user) > User UID. Everything is RLS-scoped to this.
OWNER_USER_ID=

# --- optional: only if this machine runs TLS-inspecting antivirus/proxy ---
# The pooled Postgres connection fails cert verification when traffic is
# intercepted and re-signed. Pick one:
#   DB_SSL_ROOT_CERT=C:\path\to\proxy-root.pem   verify against that CA (preferred)
#   DB_SSL_INSECURE=1                             encrypt but skip verification
DB_SSL_INSECURE=
